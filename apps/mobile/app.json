{
  "expo": {
    "name": "QuizX",
    "slug": "qu1z",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "qu1z",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.qu1z.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E0B1A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0B1A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Qu1z accède à tes photos pour que tu puisses en envoyer et choisir ta photo de profil.",
          "cameraPermission": "Qu1z utilise l’appareil photo pour que tu puisses prendre une photo à envoyer."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Qu1z utilise ta position approximative (à 10 km près) seulement si tu actives le classement « À proximité »."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF6B57"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0E0B1A"
  }
}
